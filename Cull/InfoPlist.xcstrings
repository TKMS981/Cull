    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とビデオを1枚ずつ表示して「保持」または Cull のゴミ箱へ振り分け、選んだものを削除するために使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cull shows your photos and videos one at a time so you can keep them or move them to Cull's trash, and deletes the ones you choose."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
